Project Lentera {
  database_type: 'MySQL'
  Note: 'Skema toko buku ditambahkan tanpa menghapus tabel perpustakaan yang sudah ada'
}

Table kategori {
  id integer [pk, increment]
  nama varchar(100) [not null, unique]
  deskripsi text
}

Table buku {
  id integer [pk, increment]
  kategori_id integer [not null, ref: > kategori.id]
  judul varchar(255) [not null]
  penulis varchar(150) [not null]
  penerbit varchar(150)
  tahun_terbit smallint
  isbn varchar(20) [unique]
  stok integer [not null, default: 1]
}

Table anggota {
  id integer [pk, increment]
  nama varchar(150) [not null]
  email varchar(150) [unique]
  no_telepon varchar(20)
  alamat text
  tanggal_daftar date [not null, default: `now()`]
}

Table peminjaman {
  id integer [pk, increment]
  anggota_id integer [not null, ref: > anggota.id]
  buku_id integer [not null, ref: > buku.id]
  tanggal_pinjam date [not null, default: `now()`]
  tanggal_jatuh_tempo date [not null]
  tanggal_kembali date [note: 'NULL = belum dikembalikan']
  status varchar(20) [not null, default: 'dipinjam', note: 'dipinjam / dikembalikan / terlambat']
}

Table pembeli {
  id integer [pk, increment]
  nama varchar(150) [not null]
  email varchar(150) [unique]
  no_telepon varchar(20)
  alamat text
  created_at timestamp
  updated_at timestamp
}

Table produk_toko {
  id integer [pk, increment]
  buku_id integer [not null, unique, ref: > buku.id]
  harga decimal(12,2) [not null]
  stok integer [not null, default: 0, note: 'Stok jual terpisah dari stok perpustakaan pada buku']
  aktif boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
}

Table pesanan {
  id integer [pk, increment]
  nomor_pesanan varchar(30) [not null, unique]
  pembeli_id integer [not null, ref: > pembeli.id]
  status varchar(30) [not null, default: 'menunggu_pembayaran']
  alamat_pengiriman text [not null]
  tanggal_pesanan timestamp [not null, default: `now()`]
  created_at timestamp
  updated_at timestamp
}

Table detail_pesanan {
  id integer [pk, increment]
  pesanan_id integer [not null, ref: > pesanan.id]
  produk_toko_id integer [not null, ref: > produk_toko.id]
  jumlah integer [not null]
  harga_satuan decimal(12,2) [not null]
  created_at timestamp
  updated_at timestamp
}