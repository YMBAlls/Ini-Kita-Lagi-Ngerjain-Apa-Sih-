Project perpustakaan {
  database_type: 'PostgreSQL'
  Note: 'Skema sederhana sistem peminjaman buku perpustakaan'
}

Table kategori {
  id integer [pk, increment]
  nama varchar(100) [not null, unique]
  deskripsi text
}

Table buku {
  id integer [pk, increment]
  kategori_id integer [not null, ref: > kategori.id]
  judul varchar(255) [not null]
  penulis varchar(150) [not null]
  penerbit varchar(150)
  tahun_terbit smallint
  isbn varchar(20) [unique]
  stok integer [not null, default: 1]
}

Table anggota {
  id integer [pk, increment]
  nama varchar(150) [not null]
  email varchar(150) [unique]
  no_telepon varchar(20)
  alamat text
  tanggal_daftar date [not null, default: `now()`]
}

Table peminjaman {
  id integer [pk, increment]
  anggota_id integer [not null, ref: > anggota.id]
  buku_id integer [not null, ref: > buku.id]
  tanggal_pinjam date [not null, default: `now()`]
  tanggal_jatuh_tempo date [not null]
  tanggal_kembali date [note: 'NULL = belum dikembalikan']
  status varchar(20) [not null, default: 'dipinjam', note: 'dipinjam / dikembalikan / terlambat']
}
